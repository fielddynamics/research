\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The coupling topology of a single face. \textbf  {(a)}~A triangular face of TetA. \textbf  {(b)}~When TetB couples through the Field Origin, its vertex $V_B$ penetrates the face center, subdividing the face into $3 + 1 = 4$ sub-regions: three corner sub-regions (blue) anchored at the original vertices, and one central coupling sub-region (red) at the penetration point. This is the same $3 + 1$ structure that appears within each tetrahedron ($3$ spatial $+ 1$ temporal face) and across both tetrahedra ($(3+1)^2 = 16$ interpenetrations). The polynomial's hierarchy is the topology of this single coupled face, recurring at every scale.}}{27}{figure.4}\protected@file@percent }
\newlabel{fig:face-coupling}{{4}{27}{The coupling topology of a single face. \textbf {(a)}~A triangular face of TetA. \textbf {(b)}~When TetB couples through the Field Origin, its vertex $V_B$ penetrates the face center, subdividing the face into $3 + 1 = 4$ sub-regions: three corner sub-regions (blue) anchored at the original vertices, and one central coupling sub-region (red) at the penetration point. This is the same $3 + 1$ structure that appears within each tetrahedron ($3$ spatial $+ 1$ temporal face) and across both tetrahedra ($(3+1)^2 = 16$ interpenetrations). The polynomial's hierarchy is the topology of this single coupled face, recurring at every scale}{figure.4}{}}
