\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {CamB: exterior vs effective mass.} (a) Rotation curve. Observations (black) with Newtonian (grey dashed), $\Lambda $CDM with NFW (red dotted), GFD photometric (green dashed), and velocity decode (green solid). (b) Enclosed mass: $\Lambda $CDM (red dotted), GFD photometric (green dashed), velocity-decoded effective mass (green solid); shaded region is $\Delta M_{\mathrm  {eff}}$. (c) Mass ratio $M_{\mathrm  {phot}}/M_{\mathrm  {dec}}$ over the observed range. (d) Decoded mass plus $\Delta M_{\mathrm  {eff}}(r)$ (blue) matches photometric (green dashed); shaded region is the interior contribution to the observed field.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:camb}{{2}{4}{\textbf {CamB: exterior vs effective mass.} (a) Rotation curve. Observations (black) with Newtonian (grey dashed), $\Lambda $CDM with NFW (red dotted), GFD photometric (green dashed), and velocity decode (green solid). (b) Enclosed mass: $\Lambda $CDM (red dotted), GFD photometric (green dashed), velocity-decoded effective mass (green solid); shaded region is $\Delta M_{\mathrm {eff}}$. (c) Mass ratio $M_{\mathrm {phot}}/M_{\mathrm {dec}}$ over the observed range. (d) Decoded mass plus $\Delta M_{\mathrm {eff}}(r)$ (blue) matches photometric (green dashed); shaded region is the interior contribution to the observed field}{figure.2}{}}
