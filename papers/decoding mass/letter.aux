\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Four-panel comparison for the Milky Way and M33.} (a) Milky Way rotation curve. Observations (black) are shown with Newtonian baryons (grey dashed), $\Lambda $CDM with NFW halo (red dotted), GFD from photometric mass (green dashed), and the velocity-decoded effective mass (green solid, from observed $v$ only). (b) Enclosed mass for the Milky Way: $\Lambda $CDM baryons+NFW (red dotted), GFD photometric (green dashed), velocity-decoded effective mass (green solid). (c) M33 rotation curve; curve convention as in (a). (d) M33 enclosed mass; same convention as (b).}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:1}{{1}{3}{\textbf {Four-panel comparison for the Milky Way and M33.} (a) Milky Way rotation curve. Observations (black) are shown with Newtonian baryons (grey dashed), $\Lambda $CDM with NFW halo (red dotted), GFD from photometric mass (green dashed), and the velocity-decoded effective mass (green solid, from observed $v$ only). (b) Enclosed mass for the Milky Way: $\Lambda $CDM baryons+NFW (red dotted), GFD photometric (green dashed), velocity-decoded effective mass (green solid). (c) M33 rotation curve; curve convention as in (a). (d) M33 enclosed mass; same convention as (b)}{figure.1}{}}
