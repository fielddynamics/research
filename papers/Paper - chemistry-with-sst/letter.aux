\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Shell structure from the Sierpi\'nski walk.} The SST quadratic $\mu _{\mathrm  {SST}}(i^2)$ at each walk position $i$, for four elements: O-16, Ca-40, Ni-58, and Zn-64. Coloured dots indicate occupied positions; grey dots are unfilled. Dashed vertical lines mark magic-number shell closures. Pastel bands show shell regions with capacities labelled at bottom. The narrow orange band (nucleon positions 21--28, capacity 8) is the gate-exclusion shell that reproduces the $20\!\to \!28$ gap without spin-orbit coupling.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:shells}{{1}{4}{\textbf {Shell structure from the Sierpi\'nski walk.} The SST quadratic $\mu _{\mathrm {SST}}(i^2)$ at each walk position $i$, for four elements: O-16, Ca-40, Ni-58, and Zn-64. Coloured dots indicate occupied positions; grey dots are unfilled. Dashed vertical lines mark magic-number shell closures. Pastel bands show shell regions with capacities labelled at bottom. The narrow orange band (nucleon positions 21--28, capacity 8) is the gate-exclusion shell that reproduces the $20\!\to \!28$ gap without spin-orbit coupling}{figure.1}{}}
