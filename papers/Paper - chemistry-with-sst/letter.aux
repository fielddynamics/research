\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Binding energy per nucleon from the SST quadratic.} Gold: $\mathrm  {SST}_1$ (rising curve, walk filling). Red: $\mathrm  {SST}_1^{\,\mathrm  {inv}}$ (sector~0 reflection, ceiling at $17.512$\,MeV). Purple: $\mathrm  {SST}_2^{\,\mathrm  {inv}}$ (sector~1 reflection, ceiling at $17.141$\,MeV). Blue: $\mathrm  {SST}_3^{\,\mathrm  {inv}}$ (sector~2 reflection, ceiling at $16.770$\,MeV). Teal: $B/A = \min (\text  {active curves})$, the model prediction. Pink dots: AME2020 experimental data. Yellow circles mark the Sierpi\'nski sector-fill boundaries at $K^D = 64$ (Zn), $2K^D = 128$ (Te), and $3K^D = 192$ (Os). Residuals are shown in the lower panel.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:binding}{{2}{6}{\textbf {Binding energy per nucleon from the SST quadratic.} Gold: $\mathrm {SST}_1$ (rising curve, walk filling). Red: $\mathrm {SST}_1^{\,\mathrm {inv}}$ (sector~0 reflection, ceiling at $17.512$\,MeV). Purple: $\mathrm {SST}_2^{\,\mathrm {inv}}$ (sector~1 reflection, ceiling at $17.141$\,MeV). Blue: $\mathrm {SST}_3^{\,\mathrm {inv}}$ (sector~2 reflection, ceiling at $16.770$\,MeV). Teal: $B/A = \min (\text {active curves})$, the model prediction. Pink dots: AME2020 experimental data. Yellow circles mark the Sierpi\'nski sector-fill boundaries at $K^D = 64$ (Zn), $2K^D = 128$ (Te), and $3K^D = 192$ (Os). Residuals are shown in the lower panel}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Sierpi\'nski walk packing.} Eight elements from C-12 to Zn-64, showing the 64-position walk filling progressively. Each filled tile displays the predicted $B/A$ for that element (all tiles show the same value; binding is distributed equally). Colours indicate gate depth within the fractal structure. The error decreases from 249\,keV (C-12) to 0\,keV (Zn-64, full closure at $K^D = 64$).}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:sierpinski}{{3}{6}{\textbf {Sierpi\'nski walk packing.} Eight elements from C-12 to Zn-64, showing the 64-position walk filling progressively. Each filled tile displays the predicted $B/A$ for that element (all tiles show the same value; binding is distributed equally). Colours indicate gate depth within the fractal structure. The error decreases from 249\,keV (C-12) to 0\,keV (Zn-64, full closure at $K^D = 64$)}{figure.3}{}}
