\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The coordinate-space geometry of the tetrad frame. Four million points are sampled uniformly in local frame coordinates and classified by the sign combination each point occupies under the four projections $v_i$. The primary tetrahedron (TetA) appears in blue, a second inverted tetrahedron (TetB) in red, and their shared interior, a regular octahedron, in gold. The geometry is analysed in the text. An interactive HTML rendering is provided as supplementary material.}}{1}{figure.1}\protected@file@percent }
\newlabel{fig1}{{1}{1}{The coordinate-space geometry of the tetrad frame. Four million points are sampled uniformly in local frame coordinates and classified by the sign combination each point occupies under the four projections $v_i$. The primary tetrahedron (TetA) appears in blue, a second inverted tetrahedron (TetB) in red, and their shared interior, a regular octahedron, in gold. The geometry is analysed in the text. An interactive HTML rendering is provided as supplementary material}{figure.1}{}}
\citation{Kepler1619}
\citation{Cromwell1997}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The face subdivision. (a)~One face of TetA, undivided. (b)~The opposing vertex of TetB penetrates the face, carving it into three exposed corners and one central inverted core. This $3+1$ pattern is the first Sierpinski iteration and repeats on all four faces, producing the $4 \times 4 = 16$ boundary channels of Eq.~(\ref {eq:channels}).}}{3}{figure.2}\protected@file@percent }
\newlabel{fig2}{{2}{3}{The face subdivision. (a)~One face of TetA, undivided. (b)~The opposing vertex of TetB penetrates the face, carving it into three exposed corners and one central inverted core. This $3+1$ pattern is the first Sierpinski iteration and repeats on all four faces, producing the $4 \times 4 = 16$ boundary channels of Eq.~(\ref {eq:channels})}{figure.2}{}}
\newlabel{eq:channels}{{6}{3}{The Emergent Geometry}{equation.6}{}}
